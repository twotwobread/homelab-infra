issuer: https://<DEX_DNS_NAME>
storage:
  type: sqlite3
  config:
    file: /var/dex/dex.db
web:
  # Container interface only; Compose publishes to host loopback exclusively.
  http: 0.0.0.0:5556
logger:
  level: info
  format: json
expiry:
  idTokens: 10m
  refreshTokens:
    validIfNotUsedFor: 24h
    absoluteLifetime: 168h
oauth2:
  grantTypes: [authorization_code, refresh_token]
  responseTypes: [code]
  skipApprovalScreen: false
  pkce:
    enforce: true
    codeChallengeMethodsSupported: [S256]
staticClients:
  - id: homelab-kubectl
    name: Homelab kubectl
    public: true
    redirectURIs:
      - http://localhost:8000
connectors:
  - type: github
    id: github
    name: GitHub
    config:
      clientID: $GITHUB_CLIENT_ID
      clientSecret: $GITHUB_CLIENT_SECRET
      redirectURI: https://<DEX_DNS_NAME>/callback
      loadAllGroups: false
      useLoginAsID: false
