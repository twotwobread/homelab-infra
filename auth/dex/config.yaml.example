issuer: https://<DEX_DNS_NAME>:8443
storage:
  type: sqlite3
  config:
    file: /var/dex/dex.db
web:
  # Container interface only; Compose publishes to host loopback exclusively.
  http: 0.0.0.0:5556
  # Container-only HTTPS for Vault; never publish 8443 on the host.
  https: 0.0.0.0:8443
  tlsCert: /etc/dex/tls/server.crt
  tlsKey: /etc/dex/tls/server.key
logger:
  level: info
  format: json
expiry:
  idTokens: 10m
  refreshTokens:
    validIfNotUsedFor: 24h
    absoluteLifetime: 168h
oauth2:
  grantTypes: [authorization_code, refresh_token]
  responseTypes: [code]
  skipApprovalScreen: false
  pkce:
    enforce: true
    codeChallengeMethodsSupported: [S256]
staticClients:
  - id: homelab-kubectl
    name: Homelab kubectl
    public: true
    redirectURIs:
      - http://localhost:8000
  - id: homelab-vault
    name: Homelab Vault
    secretEnv: VAULT_OIDC_CLIENT_SECRET
    redirectURIs:
      - https://<VAULT_DNS_NAME>:8200/ui/vault/auth/oidc/oidc/callback
connectors:
  - type: github
    id: github
    name: GitHub
    config:
      clientID: $GITHUB_CLIENT_ID
      clientSecret: $GITHUB_CLIENT_SECRET
      redirectURI: https://<DEX_DNS_NAME>:8443/callback
      loadAllGroups: false
      useLoginAsID: false
